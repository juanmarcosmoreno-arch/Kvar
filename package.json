{
  "name": "stoka",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "bash supabase/tests/run-local.sh",
    "icons": "node scripts/generate-icons.mjs",
    "ios": "npm run build && node scripts/sync-ios-version.mjs && cap sync ios && cap open ios",
    "ios:sync": "npm run build && node scripts/sync-ios-version.mjs && cap sync ios",
    "ios:release": "npm run build && node scripts/sync-ios-version.mjs --bump && cap sync ios && cap open ios",
    "build:precios-web": "node scripts/build-precios-web.mjs",
    "build:demo": "VITE_DEMO=1 vite build && node scripts/build-demo.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@supabase/supabase-js": "^2.117.3",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "fake-indexeddb": "^6.2.5",
    "playwright": "^1.56.1",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4.19",
    "typescript": "5.6",
    "vite": "^5.4.21",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-singlefile": "^2.0.3",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=22"
  }
}
