# --- Cliente (Vite) ---------------------------------------------------------
# Solo valores públicos: la anon key está protegida por Row Level Security.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
# Dirección pública de la versión web: la usan los links de invitación desde la app de iPhone.
VITE_PUBLIC_URL=https://kvar.vercel.app
# Ficha del App Store (cuando esté publicada), para el botón «Actualizá Kvar».
VITE_APP_STORE_URL=

# --- Edge Functions (Fase 2 en adelante) --------------------------------------
# NUNCA van en el cliente. Se cargan con:
#   supabase secrets set --env-file supabase/functions/.env
# AI_PROVIDER: anthropic | openai | gemini
AI_PROVIDER=anthropic
AI_MODEL=
AI_API_KEY=
# Recorte de fotos en servidor si el dispositivo no puede (Fase 2): imgly | replicate | none
IMAGE_CUTOUT_PROVIDER=none
# Notificaciones push web (Fase 4)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hola@ejemplo.com
